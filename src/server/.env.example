PORT=3000

# Public tunnel/deployment host without a path. Both forms are accepted:
# HOSTNAME=example.trycloudflare.com
# HOSTNAME=https://example.trycloudflare.com
HOSTNAME=

# Comma-separated browser origins allowed to call this server.
# Use * for local testing, then set your IC frontend origin for production.
# Example: FRONTEND_ORIGIN=https://2nukr-cyaaa-aaaak-qy2ja-cai.icp0.io
FRONTEND_ORIGIN=*

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

XAI_API_KEY=
XAI_MODEL=grok-voice-think-fast-1.0
XAI_VOICE=eve

# Optional. Set to true after your public URL is stable and requests validate.
VALIDATE_TWILIO_SIGNATURE=false

# Optional first turn for outbound calls.
CALL_GREETING=The phone call is now connected. Briefly introduce yourself and ask how you can help.
