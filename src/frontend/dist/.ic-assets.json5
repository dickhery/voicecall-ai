[
  {
    "match": "**/*",
    "security_policy": "standard",
    "headers": {
      "Cache-Control": "public, max-age=0, must-revalidate",
      // Keep this in sync with src/frontend/env.json voice_server_url.
      "Content-Security-Policy": "default-src 'self'; connect-src 'self' http://localhost:3000 http://127.0.0.1:3000 ws://localhost:3000 ws://127.0.0.1:3000 https://icp-api.io https://ic0.app https://*.ic0.app https://icp0.io https://*.icp0.io https://identity.internetcomputer.org https://identity.ic0.app https://blob.caffeine.ai https://voicecall.richardhery.com wss://voicecall.richardhery.com; img-src 'self' data: blob: https://blob.caffeine.ai; media-src 'self' data: blob: http://localhost:3000 http://127.0.0.1:3000 https://voicecall.richardhery.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src https://identity.internetcomputer.org https://identity.ic0.app; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    },
    "allow_raw_access": false
  },
  {
    "match": "assets/**/*",
    "headers": {
      "Cache-Control": "public, max-age=31536000, immutable"
    }
  },
  {
    "match": "**/*",
    "enable_aliasing": true
  }
]
